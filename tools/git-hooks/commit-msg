#!/bin/bash
# commit-msg hook: enforce the project's commit-message conventions.
#
# Rules (see AGENTS.md > Commit conventions):
#   - Reject Co-Authored-By trailers naming an AI agent.
#   - Reject "Generated with ..." boilerplate footers.
#   - Reject "Claude:", "Codex:", "ChatGPT:" subject-line prefixes.
#   - If an Assisted-by: trailer is present, validate its format.
#   - Reject U+2014 em-dashes anywhere in the message.
#
# Install: ./tools/setup-git-hooks.sh
#
# To bypass in an emergency: git commit --no-verify (the project policy
# discourages this; use only when truly necessary, e.g. a merge commit
# from a tool that you cannot configure).

set -u

msg_file="$1"
msg="$(cat "$msg_file")"
errors=()

# 1. Co-authored-by trailers.
#
# Match the trailer shape, not a list of vendor names. This check previously
# enumerated ten vendors, so trailers naming GPT-5, Llama, or any other
# unlisted model passed while Claude and Gemini were blocked. A name list is
# always one model behind. The trailer is reserved for human collaborators
# (AGENTS.md > Commit conventions), so a genuine human coauthor sets
# ALLOW_COAUTHOR=1.
while IFS= read -r line ; do
  if [[ "$line" =~ ^[[:space:]]*[Cc]o[-_\ ]?[Aa]uthored[-_\ ]?[Bb]y: ]] ; then
    if [[ "${ALLOW_COAUTHOR:-0}" != "1" ]] ; then
      errors+=("Co-authored-by is reserved for human collaborators:")
      errors+=("    $line")
      errors+=("    Use 'Assisted-by: <agent> (<model>)' for AI assistance, or")
      errors+=("    ALLOW_COAUTHOR=1 git commit ... for a genuine human coauthor.")
    fi
  fi
done <<< "$msg"

# 2. "Generated with" boilerplate.
if echo "$msg" | grep -qE '🤖|Generated with .*(Claude|Codex|Copilot|Cursor|Aider)' ; then
  errors+=("Forbidden 'Generated with ...' boilerplate found.")
  errors+=("    Remove the line. Use the Assisted-by: trailer instead.")
fi

# 3. Subject-line prefixes naming the AI agent.
subject="$(printf '%s' "$msg" | head -n 1)"
if [[ "$subject" =~ ^(Claude|Codex|ChatGPT|Copilot|Aider|Cursor)[[:space:]]*: ]] ; then
  errors+=("Subject line starts with an AI agent name (\"${BASH_REMATCH[1]}:\").")
  errors+=("    Rewrite the subject to describe the change, not the author.")
fi

# 4. Validate Assisted-by: format if present.
while IFS= read -r line ; do
  if [[ "$line" =~ ^[Aa]ssisted-[Bb]y: ]] ; then
    if [[ ! "$line" =~ ^Assisted-by:\ [A-Za-z][A-Za-z0-9\ ]*\ \([a-z][a-z0-9.\-]*\)$ ]] ; then
      errors+=("Malformed Assisted-by trailer:")
      errors+=("    $line")
      errors+=("    Expected: 'Assisted-by: <Agent Name> (<model-id>)'")
      errors+=("    Examples: Assisted-by: Claude Code (claude-sonnet-4-6)")
      errors+=("              Assisted-by: OpenAI Codex (gpt-5)")
    fi
  fi
done <<< "$msg"

# 5. Reject U+2014 em-dashes (AGENTS.md: use commas, colons, periods, or
# parentheses instead). Scan only the human-authored message: drop git's
# verbose-diff scissors region and comment lines so an em-dash in a `-v`
# diff or in git's help text can't trip the check. Match the raw UTF-8
# bytes (E2 80 94) under LC_ALL=C: portable to macOS bash 3.2 / BSD grep,
# which lack \uXXXX escapes and grep -P.
scan="$(printf '%s\n' "$msg" | sed '/^#.*>8/,$d' | grep -v '^#')"
emdash=$'\xe2\x80\x94'
if printf '%s' "$scan" | LC_ALL=C grep -qF "$emdash" ; then
  errors+=("Em-dash (U+2014) found in the commit message.")
  errors+=("    Use a comma, colon, period, or parentheses instead.")
fi

if [[ ${#errors[@]} -gt 0 ]] ; then
  {
    echo
    echo "commit-msg hook rejected this commit:"
    echo
    for err in "${errors[@]}" ; do
      echo "  $err"
    done
    echo
    echo "See AGENTS.md > Commit conventions for the full rules."
    echo "To bypass (rarely justified): git commit --no-verify"
    echo
  } >&2
  exit 1
fi

exit 0
