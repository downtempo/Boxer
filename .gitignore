#Ignore Finder metadata files
.DS_Store
._*

#No build directories thanks
build

#Ignore user-specific stuff in .xcodeproj bundles
*.pbxuser
*.perspective
*.perspectivev3
*.mode1v3
*.mode2v3
xcuserdata/
project.xcworkspace
DerivedData/
swiftpm/
# Track the workspace SPM lockfile so dependency revisions are reproducible.
# Deps track branches (not tags), so without the committed lockfile, builds float.
!Boxer.xcworkspace/xcshareddata/swiftpm/
!Boxer.xcworkspace/xcshareddata/swiftpm/Package.resolved

#Modern Xcode artifacts
*.xcuserstate
*.xccheckout
*.moved-aside
*.hmap
*.dSYM
*.dSYM.zip
.swiftpm/
.build/

#AI assistant and IDE state (per-user)
.claude/
.cursor/
.idea/
.vscode/
.aider*

#Local git worktrees
.worktrees/
worktrees/

#Editor scratch files
*.swp
*~

#Python bytecode (from reindex_help.py)
__pycache__/
*.pyc
